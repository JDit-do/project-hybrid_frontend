# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# AWS Cognito (Required)
COGNITO_CLIENT_ID=<AWS COGNITO_CLIENT_ID>
COGNITO_CLIENT_SECRET=<AWS COGNITO_CLIENT_SECRET>
COGNITO_ISSUER=<AWS COGNITO_ISSUER>

# Development Environment API URLs
NEXT_PUBLIC_GRAPHQL_ENDPOINT_DEV=http://localhost:3000/api/graphql
NEXT_PUBLIC_PRESIGN_API_DEV=http://localhost:3000/api/presign
NEXT_PUBLIC_API_URL_DEV=http://localhost:3000
NEXT_PUBLIC_CLOUDFRONT_DOMAIN_DEV=your-dev-cloudfront-domain.cloudfront.net

# Production Environment API URLs
NEXT_PUBLIC_GRAPHQL_ENDPOINT_PROD=https://your-prod-appsync-url.amazonaws.com/graphql
NEXT_PUBLIC_PRESIGN_API_PROD=https://your-prod-presign-api.com/api/presign
NEXT_PUBLIC_API_URL_PROD=https://your-prod-api.com
NEXT_PUBLIC_CLOUDFRONT_DOMAIN_PROD=your-prod-cloudfront-domain.cloudfront.net

# Legacy Environment Variables (for backward compatibility)
APP_SYNC_URL=<AWS APP_SYNC_URL>
NEXT_PUBLIC_PRESIGN_API=<AWS PRESIGN_API>
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
NEXT_PUBLIC_API_URL=<API_BASE_URL>

# Development Settings (Optional)
# Set to 'true' to use mock APIs instead of real AWS services
USE_MOCK_APIS=true

# Set to 'true' to skip environment variable validation
SKIP_ENV_VALIDATION=true

# Force specific environment (Optional)
# FORCE_DEV_API=true
# FORCE_PROD_API=true